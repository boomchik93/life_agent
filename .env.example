# Копия этого файла -> .env (в .gitignore). Ключи сюда, не в чат.

# Токен доступа: 32+ случайных байт (openssl rand -hex 32)
ACCESS_TOKEN=

# LLM-провайдеры
OPENROUTER_API_KEY=

# Google Calendar: путь к JSON-ключу сервисного аккаунта
GOOGLE_SA_KEY_FILE=./secrets/sa-key.json
# id календарей через запятую; первый, в который пишет агент, — CALENDAR_WRITE_ID
CALENDAR_IDS=
CALENDAR_WRITE_ID=
# Необязательно: ICS-ссылка с расписанием пар
ICS_URL=

# Этап 10: серверные источники активности (необязательно, без ключей источник выключен)
# Steam: Web API key (https://steamcommunity.com/dev/apikey) и SteamID64; профиль и список игр должны быть публичными
STEAM_API_KEY=
STEAM_ID=
# GitHub: fine-grained токен только на чтение (срок до 90 дней) и логин; в профиле включить «Include private contributions»
GITHUB_TOKEN=
GITHUB_LOGIN=
# LeetCode (запасной неофициальный путь, необязательно): логин
LEETCODE_USER=

# Шифрование бэкапов: публичный ключ age (age-keygen на маке). Приватный ключ остаётся на маке.
AGE_RECIPIENT=

# Сервер
LISTEN_ADDR=127.0.0.1:18010
DB_PATH=./data/life-agent.db
TIMEZONE=Asia/Yekaterinburg
