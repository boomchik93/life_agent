# Копия этого файла -> .env (в .gitignore). Ключи сюда, не в чат.

# Токен доступа: 32+ случайных байт (openssl rand -hex 32)
ACCESS_TOKEN=

# LLM-провайдеры
OPENROUTER_API_KEY=

# Google Calendar: путь к JSON-ключу сервисного аккаунта
GOOGLE_SA_KEY_FILE=./secrets/sa-key.json
# id календарей через запятую; первый, в который пишет агент, — CALENDAR_WRITE_ID
CALENDAR_IDS=
CALENDAR_WRITE_ID=
# Необязательно: ICS-ссылка с расписанием пар
ICS_URL=

# Шифрование бэкапов: публичный ключ age (age-keygen на маке). Приватный ключ остаётся на маке.
AGE_RECIPIENT=

# Сервер
LISTEN_ADDR=127.0.0.1:18010
DB_PATH=./data/life-agent.db
TIMEZONE=Asia/Yekaterinburg
